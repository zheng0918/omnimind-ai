# OmniMind AI 服务环境变量示例
# 复制为 .env 后填入真实值；.env 禁止提交进 git。
# 所有密钥仅通过环境变量注入，业务代码禁止散落 os.environ.get。

# ---- 数据库（仅 omnimind_ai schema，账号 ai_rw）----
DATABASE_URL=postgresql+asyncpg://ai_rw:<set in .env>@localhost:5432/omnimind
DATABASE_SCHEMA=omnimind_ai
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ---- Milvus 向量库 ----
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=omnimind_chunks

# ---- MinIO 对象存储（只读源文件）----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=<set in .env>
MINIO_SECRET_KEY=<set in .env>
MINIO_BUCKET=omnimind-files
MINIO_SECURE=false

# ---- DeepSeek（OpenAI 兼容协议）----
DEEPSEEK_API_KEY=<set in .env>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.2
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_REQUEST_TIMEOUT_S=60

# ---- 阿里云百炼（Embedding + Rerank）----
DASHSCOPE_API_KEY=<set in .env>
DASHSCOPE_EMBED_MODEL=text-embedding-v3
DASHSCOPE_RERANK_MODEL=gte-rerank
EMBED_DIM=1024
EMBED_BATCH_SIZE=25
EMBED_CONCURRENCY=5

# ---- Agent 并发与超时 ----
REVIEW_PARALLEL=10
WRITE_PARALLEL=5
AGENT_MAX_RETRY=2
AGENT_STEP_TIMEOUT_S=60

# ---- Java 回调 ----
JAVA_BASE_URL=http://localhost:8080
JAVA_INTERNAL_TOKEN=<set in .env>
JAVA_CALLBACK_TIMEOUT_S=10

# ---- 内部鉴权（与 Java 网关共享）----
INTERNAL_TOKEN=<set in .env>

# ---- Prompt 版本 ----
PROMPT_VER=v1

# ---- 日志 ----
LOG_LEVEL=INFO
