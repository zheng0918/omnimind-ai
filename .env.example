# OmniMind AI 服务环境变量示例
# 复制为 .env 后填入真实值；.env 禁止提交进 git。
# 所有密钥仅通过环境变量注入，业务代码禁止散落 os.environ.get。

# ---- 数据库（独立 omnimind_ai 库，默认 public schema，账号 ai_rw）----
DATABASE_URL=postgresql+asyncpg://ai_rw:<set in .env>@localhost:5432/omnimind_ai
DATABASE_SCHEMA=public
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ---- Milvus 向量库 ----
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=omnimind_chunks

# ---- MinIO 对象存储（只读源文件）----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=<set in .env>
MINIO_SECRET_KEY=<set in .env>
MINIO_BUCKET=omnimind-files
MINIO_SECURE=false

# ---- DeepSeek（OpenAI 兼容协议）----
DEEPSEEK_API_KEY=<set in .env>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.2
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_REQUEST_TIMEOUT_S=60

# ---- 阿里云百炼（Embedding + Rerank）----
DASHSCOPE_API_KEY=<set in .env>
DASHSCOPE_EMBED_MODEL=text-embedding-v4
DASHSCOPE_RERANK_MODEL=qwen3-rerank
EMBED_DIM=2048
EMBEDDING_VERSION=text-embedding-v4
EMBED_BATCH_SIZE=25
EMBED_CONCURRENCY=5

# ---- Agent 并发与超时 ----
REVIEW_PARALLEL=10
WRITE_PARALLEL=5
AGENT_MAX_RETRY=2
AGENT_STEP_TIMEOUT_S=60

# ---- Java 回调（对应 omnimind-server）----
# JAVA_BASE_URL 取 server 端 server.port（默认 8200）；回调走 /internal/**。
JAVA_BASE_URL=http://localhost:8200
# 与 server 端 omnimind.ai-service.internal-token 一致；开发默认 local-internal-token，
# 生产由 server 的 AI_INTERNAL_TOKEN 覆盖后两边同步改为真实密钥。
JAVA_INTERNAL_TOKEN=local-internal-token
JAVA_CALLBACK_TIMEOUT_S=10

# ---- 内部鉴权（与 Java 网关共享 X-Internal-Token）----
# 必须等于 JAVA_INTERNAL_TOKEN（双向共用同一密钥）。
INTERNAL_TOKEN=local-internal-token

# ---- Prompt 版本 ----
PROMPT_VER=v1

# ---- 日志 ----
LOG_LEVEL=INFO
